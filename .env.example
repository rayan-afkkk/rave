# Google Maps SDK for Android key (Primary Google Maps provider)
MAPS_API_KEY=YOUR_MAPS_API_KEY

# MapTiler API Key (100k loads/month free, no CC required)
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# LocationIQ API Key (5k requests/day free, no CC required)
LOCATIONIQ_API_KEY=YOUR_LOCATIONIQ_API_KEY

# Geoapify API Key (3k credits/day free, with attribution)
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

# TomTom API Key (200k tiles, 20k routing requests/month free, no CC required)
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY

# Mapbox Access Token (50k web map loads / mobile free tier)
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

# Domain used for invite App Links: https://<INVITE_DOMAIN>/invite/{code}
INVITE_DOMAIN=rave.example.com

# Facebook App ID, required by Instagram's "Share to Story" intent (optional)
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
